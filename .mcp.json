{
  "mcpServers": {
    "microsoft-learn": {
      "type": "http",
      "url": "https://learn.microsoft.com/api/mcp"
    },
    "ado": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@azure-devops/mcp", "${user_config.ado_org}",
               "-d", "core", "repositories", "work-items", "search", "work",
               "--authentication", "azcli"]
    }
  }
}
