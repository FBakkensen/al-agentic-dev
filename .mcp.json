{
  "mcpServers": {
    "nab-al-tools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@nabsolutions/nab-al-tools-mcp"
      ],
      "tools": [
        "initialize",
        "createLanguageXlf",
        "refreshXlf",
        "getGlossaryTerms",
        "getTextsToTranslate",
        "getTextsByKeyword",
        "getTranslatedTextsByState",
        "getTranslatedTextsMap",
        "saveTranslatedTexts"
      ]
    },
    "microsoft-learn": {
      "type": "http",
      "url": "https://learn.microsoft.com/api/mcp",
      "tools": [
        "microsoft_docs_search",
        "microsoft_docs_fetch",
        "microsoft_code_sample_search"
      ]
    },
    "bc-code-intelligence": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "bc-code-intelligence-mcp@1.7.6"
      ],
      "tools": [
        "find_bc_knowledge",
        "get_bc_topic",
        "ask_bc_expert",
        "analyze_al_code",
        "set_workspace_info"
      ]
    },
    "business-central": {
      "type": "stdio",
      "command": "pwsh",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-NonInteractive",
        "-Command",
        "& (Join-Path $env:COPILOT_PLUGIN_ROOT 'skills\\al-build\\scripts\\start-business-central-mcp.ps1')"
      ],
      "tools": [
        "bc_open_page",
        "bc_read_data",
        "bc_write_data",
        "bc_execute_action",
        "bc_close_page",
        "bc_search_pages",
        "bc_navigate",
        "bc_respond_dialog",
        "bc_switch_company",
        "bc_list_companies",
        "bc_run_report",
        "bc_wizard_navigate",
        "bc_lookup"
      ]
    }
  }
}
