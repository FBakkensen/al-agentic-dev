{
  "mcpServers": {
    "nab-al-tools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@nabsolutions/nab-al-tools-mcp"
      ],
      "tools": [
        "initialize",
        "createLanguageXlf",
        "refreshXlf",
        "getGlossaryTerms",
        "getTextsToTranslate",
        "getTextsByKeyword",
        "getTranslatedTextsByState",
        "getTranslatedTextsMap",
        "saveTranslatedTexts"
      ]
