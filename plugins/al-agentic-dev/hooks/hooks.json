{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "powershell": "[Console]::OutputEncoding = [System.Text.Encoding]::UTF8; $f = Join-Path $env:COPILOT_PLUGIN_ROOT 'references/GROUND-RULES.md'; if (Test-Path $f) { @{ additionalContext = (Get-Content -Raw $f) } | ConvertTo-Json -Compress }",
        "timeoutSec": 15
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "powershell": "& (Join-Path $env:COPILOT_PLUGIN_ROOT 'hooks/Invoke-TaskGrammarHook.ps1')",
        "timeoutSec": 30
      }
    ]
  }
}
